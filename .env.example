PORT=5000

# Optional. If omitted, it is derived dynamically:
# development/test -> http://localhost:${PORT}
# production       -> https://localhost:${PORT}
# Example for Render: https://smarthouserental.onrender.com
APP_BASE_URL=

# Local (no Docker): use localhost. Create DB: psql -U postgres -c "CREATE DATABASE house_rental;"
# Docker: start with docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/house_rental
REDIS_URL=redis://localhost:6379

# Docker Compose Configuration Overrides
# ---------------------------------------------
# Postgres container settings (used when DATABASE_URL is not set):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=house_rental
DB_PORT=5432

# Redis container port:
REDIS_PORT=6379

# Embedding service container port:
EMBEDDING_PORT=8002

# Note on Docker database connectivity:
# - By default, the docker backend uses the main DATABASE_URL, DIRECT_URL, REDIS_URL, and EMBEDDING_URL defined above.
# - If you want the docker container to connect to the local docker-compose databases instead of external services,
#   simply comment out DATABASE_URL, DIRECT_URL, REDIS_URL, and EMBEDDING_URL from this file. The docker setup will
#   then dynamically fall back to the internal services using the POSTGRES_USER, POSTGRES_PASSWORD, etc. configured above.

# Resend Email Provider
# Create API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use your verified domain sender in production
EMAIL_FROM=House Rental <onboarding@resend.dev>
# Optional support email shown in templates
SUPPORT_EMAIL=support@house-rental.com

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-token-secret-must-be-different-and-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
# Optional comma-separated list for extra allowed frontend origins.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com

# Required for email features (verification, forgot password)
# RESEND_API_KEY and EMAIL_FROM are used by the backend email service

NODE_ENV=development

# Bearer token for recommendation service export (GET /interactions/export/user/:userId)
RECOMMENDATION_SERVICE_TOKEN=your-recommendation-service-secret-token

