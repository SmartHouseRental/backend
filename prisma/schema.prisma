// Prisma schema for Smart House Rental Platform
// Add your ER diagram models here

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// =======================
// AUTH MODELS
// =======================

// User model (core authentication + roles)
model User {
  id            String  @id @default(cuid())
  first_name    String?
  last_name     String?
  email         String? @unique
  password      String? // Add this for credentials login
  emailVerified Boolean @default(false) // Changed from DateTime? to Boolean based on snippet, check logic
  // actually standard next-auth uses DateTime? for emailVerified. But snippet says Boolean @default(false). I will stick to snippet.
  // Wait, NextAuth usually uses DateTime for emailVerified. If I use Boolean, it might conflict if I use NextAuth adapter later.
  // User snippet explicitly says: "emailVerified Boolean @default(false)". I will follow snippet.
  image         String?
  phone         String? @unique
  location      String?
  bio           String?

  role              Role    @default(renter)
  preferredLanguage String?
  isVerified        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Relations
  accounts      Account[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  
  // Messaging relations
  messagesSent     Message[]         @relation("UserMessages")
  messageReactions MessageReaction[]
  properties       Property[]        @relation("OwnerProperties")

  // properties        Property[] @relation("OwnerProperties")
  // appointmentsRenter Appointment[] @relation("RenterAppointments")
  // appointmentsOwner  Appointment[] @relation("OwnerAppointments")

  // inside User model

  renterConversations Conversation[] @relation("RenterConversations")
  ownerConversations  Conversation[] @relation("OwnerConversations")
  renterAppointments  Appointment[]  @relation("RenterAppointments")
  ownerAppointments   Appointment[]  @relation("OwnerAppointments")
  notifications       Notification[]
  auditLogs           AuditLog[]

  status            UserStatus @default(active)
  verificationState VerificationState @default(pending)

  renterAgreements  Agreement[] @relation("RenterAgreements")
  ownerAgreements   Agreement[] @relation("OwnerAgreements")
  reportsSubmitted  Report[] @relation("SubmittedReports")
  verificationDocs  VerificationDocument[] @relation("VerificationDocuments")
  reviewedDocs      VerificationDocument[] @relation("ReviewedDocuments")

  reviews           Review[]
  // notifications     Notification[]

  preferences      UserPreference?
  searchHistories  SearchHistory[]
  interactions     UserInteraction[]
  
  bankDetail            BankDetail?
  notificationPreference NotificationPreference?

  // reportsSubmitted  Report[] @relation("SubmittedReports")
  // reportsAgainst    Report[] @relation("ReportsAgainst")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum Role {
  renter
  owner
  admin
}

enum UserStatus {
  active
  suspended
  pending
}

enum VerificationState {
  verified
  pending
  rejected
  resubmit
}

// =======================
// MESSAGING MODELS
// =======================

model Conversation {
  id String @id @default(cuid())

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  renterId String
  renter   User   @relation("RenterConversations", fields: [renterId], references: [id])

  ownerId String
  owner   User   @relation("OwnerConversations", fields: [ownerId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([renterId])
  @@index([ownerId])
  @@index([propertyId])
}

model Property {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  type   PropertyType
  status PropertyStatus @default(AVAILABLE)

  title       Json
  description Json
  location    String
  address     String?
  reviews Review[]
  

  price     Float
  bedrooms  Int?
  bathrooms Int?
  area      Float?

  amenities      Json
  furnishingType String?

  images String[] @default([])
  videos String[] @default([])

  rentTerms Json?

  viewsCount Int @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  appointments  Appointment[]
  agreements    Agreement[]
  interactions UserInteraction[]
  embedding   PropertyEmbedding?
  @@index([ownerId])
  @@index([price])
  @@index([status])
  @@index([type])
  @@index([isDeleted])
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  RENTED
  UNAVAILABLE
  MAINTENANCE
}

enum PropertyType {
  VILLA
  APARTMENT
  CONDO
  STUDIO
  HOUSE
  PENTHOUSE
}

model Appointment {
  id         String            @id @default(cuid())
  propertyId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renterId   String
  renter     User              @relation("RenterAppointments", fields: [renterId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User              @relation("OwnerAppointments", fields: [ownerId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(PENDING)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([propertyId])
  @@index([renterId])
  @@index([ownerId])
  @@index([startsAt])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  senderId String
  sender   User   @relation("UserMessages", fields: [senderId], references: [id])

  type    MessageType   @default(TEXT)
  content String
  status  MessageStatus @default(SENT)

  attachments MessageAttachment[]
  reactions   MessageReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  eventType  String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([eventType])
  @@index([entityType])
  @@index([createdAt])
}

enum NotificationType {
  MESSAGE_NEW
  APPOINTMENT_BOOKED
  APPOINTMENT_UPDATED
  PAYMENT_RECEIVED
  PAYMENT_CONFIRMED
}

// =======================
// ADMIN & PLATFORM MODELS
// =======================

model Agreement {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renterId      String
  renter        User     @relation("RenterAgreements", fields: [renterId], references: [id])
  ownerId       String
  owner         User     @relation("OwnerAgreements", fields: [ownerId], references: [id])
  monthlyRent   Float
  currency      String   @default("ETB")
  startDate     DateTime
  endDate       DateTime
  status        AgreementStatus @default(draft)
  paymentStatus PaymentStatus @default(pending)
  payments      Payment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId])
  @@index([renterId])
  @@index([ownerId])
}

enum AgreementStatus {
  active
  pending_renter
  pending_owner
  draft
  terminated
  expired
}

enum PaymentStatus {
  confirmed
  proof_uploaded
  pending
}

model Payment {
  id          String        @id @default(cuid())
  agreementId String
  agreement   Agreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String        @default("ETB")
  proofUrl    String?
  status      PaymentStatus @default(pending)
  paidAt      DateTime      @default(now())
  confirmedAt DateTime?
  stripeId    String?       @unique // Added for Stripe integration
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([agreementId])
  @@index([status])
  @@index([paidAt])
}

model Report {
  id             String    @id @default(cuid())
  reportedById   String
  reportedBy     User      @relation("SubmittedReports", fields: [reportedById], references: [id])
  targetId       String
  targetType     ReportTargetType
  category       String
  description    String
  status         ReportStatus @default(open)
  ownerResponse  String?
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([reportedById])
  @@index([targetId])
}

enum ReportTargetType {
  property
  user
  agreement
  other
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed
}

model VerificationDocument {
  id             String   @id @default(cuid())
  userId         String   @unique                            // one record per user
  user           User     @relation("VerificationDocuments", fields: [userId], references: [id])
  frontUrl       String?                                     // NATIONAL_ID_FRONT
  backUrl        String?                                     // NATIONAL_ID_BACK
  livePhotoUrl   String?                                     // OWNER_PHOTO
  status         VerificationStatus @default(pending)        // admin reviews once
  submittedAt    DateTime @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?    @relation("ReviewedDocuments", fields: [reviewedById], references: [id])

  @@index([userId])
}

// enum VerificationDocumentType {
//   national_id
//   passport
//   ownership_deed
// }

enum VerificationStatus {
  pending
  approved
  rejected
  resubmit
}

model Review {
  id String @id @default(cuid())

  reviewerId String
  reviewer   User @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rating  Int
  comment String
  reply   String?
  repliedAt DateTime?

  status ReviewStatus @default(published)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewerId])
  @@index([propertyId])
  @@unique([reviewerId, propertyId])
}

enum ReviewTargetType {
  property
  owner
}

enum ReviewStatus {
  published
  flagged
  removed
}


model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredPriceMin  Float?
  preferredPriceMax  Float?
  preferredCurrency  String?  @default("ETB")
  preferredBedrooms  Int?
  preferredLocations Json?    // Array of { address: string, lat: number, lng: number }
  preferredAmenities String[]
  preferredType      PropertyType?
  furnishStatus      String?  // furnished, semi-furnished, unfurnished

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserInteraction {
  id         String   @id @default(cuid())
  userId     String   
  propertyId String

  type       InteractionType
  

  createdAt  DateTime @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, propertyId])
  @@index([type])
}
enum InteractionType {
  VIEW
  LIKE
  SAVE
}

model PropertyEmbedding {
  id         String   @id @default(cuid())
  propertyId String   @unique
  embedding  Float[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// =======================
// PROFILE & BANKING MODELS
// =======================

model BankDetail {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName        String
  accountNumber   String   // Stored encrypted in production
  holderName      String
  branch          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments    Boolean  @default(true)
  agreements      Boolean  @default(true)
  payments        Boolean  @default(true)
  reviews         Boolean  @default(false)
  reports         Boolean  @default(true)
  system          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}